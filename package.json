{
	"name": "folio",
	"version": "0.1.0",
	"private": true,
	"description": "Self-hosted client galleries and print store for photographers.",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"better-sqlite3": "12.11.1",
		"drizzle-orm": "0.45.4",
		"exifr": "7.1.3",
		"nodemailer": "10.2.1",
		"qrcode": "1.5.4",
		"sharp": "0.35.5",
		"yauzl": "3.3.2",
		"yazl": "3.3.1"
	},
	"devDependencies": {
		"@fontsource-variable/cormorant-garamond": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jost": "5.3.0",
		"@fontsource-variable/playfair-display": "5.3.0",
		"@fontsource-variable/source-sans-3": "5.3.1",
		"@lucide/svelte": "1.61.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "22.20.5",
		"@types/nodemailer": "8.0.2",
		"@types/qrcode": "1.5.5",
		"@types/yauzl": "3.3.0",
		"@types/yazl": "3.3.1",
		"drizzle-kit": "0.31.11",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "5.9.3",
		"vite": "7.3.7",
		"vitest": "3.2.7"
	}
