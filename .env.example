# Folio settings. Copy this file to .env (next to docker-compose.yml) and change the values.
# Lines that start with # are comments. Leave a value empty if you do not need it.

# User and group that own your photo folder. Run `id` on the server to find them
# (on a Synology NAS this is often 1026 and 100).
PUID=1000
PGID=1000

# Your time zone, e.g. Europe/Copenhagen, Europe/London, America/New_York.
TZ=Europe/Copenhagen

# The public address of your galleries, once they are reachable on your own domain with HTTPS.
# Leave it empty while you only use Folio on your local network.
# When it is set, always open Folio on this address (also the admin).
BASE_URL=

# How much Folio writes to the log: debug, info, warn or error.
LOG_LEVEL=info

# Optional: email settings. You can also enter them in the admin under Settings → Email sending.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=you@example.com
# SMTP_FROM_NAME=Your Studio
